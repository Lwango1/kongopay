# === Clés API pour KongoPay Backend ===

# Firebase Admin SDK (obligatoire pour notifications push FCM)
# Depuis Firebase Console > Project Settings > Service Accounts > Générer une clé privée
FIREBASE_PROJECT_ID=votre_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@votre-projet.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nvotre_cle_ici\n-----END PRIVATE KEY-----\n"

# Finnhub (calendrier économique temps réel)
# Gratuit : 60 appels/min, pas de carte bancaire
# Inscription : https://finnhub.io/register → clé API gratuite
FINNHUB_API_KEY=votre_cle_ici
