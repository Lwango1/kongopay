# Deriv API — Connexion WebSocket en temps réel
# Token pour compte réel (obtenu depuis https://app.deriv.com/account/api-token)
NEXT_PUBLIC_DERIV_TOKEN=pat_votre_token_deriv

# API Backend URL (optionnel, défaut: http://localhost:3000/api)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Google AdSense Publisher ID (ex: ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_ID=
