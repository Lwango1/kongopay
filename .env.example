# Deriv API — Connexion WebSocket en temps réel
# Token pour compte réel (obtenu depuis https://app.deriv.com/account/api-token)
NEXT_PUBLIC_DERIV_TOKEN=pat_votre_token_deriv

# API Backend URL (optionnel, défaut: http://localhost:3000/api)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Firebase Admin SDK (pour les notifications push FCM — optionnel)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Google AdSense Publisher ID (ex: ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_ID=

# Firebase Cloud Messaging VAPID Key (web push) — depuis Firebase Console > Cloud Messaging > Web Push
# Générer une paire de clés si pas encore fait
NEXT_PUBLIC_FIREBASE_VAPID_KEY=


